SPRING_PROFILES_ACTIVE=development
HOST=0.0.0.0
PORT=8080

LOG_LEVEL=DEBUG

TOMCAT_CONNECTION_TIMEOUT=2s
TOMCAT_KEEP_ALIVE_TIMEOUT=30s
TOMCAT_MAX_CONNECTIONS=8192
TOMCAT_ACCEPT_COUNT=100
TOMCAT_MAX_KEEP_ALIVE_REQUESTS=100
TOMCAT_MAX_THREADS=200
TOMCAT_MIN_SPARE_THREADS=10
SHUTDOWN_TIMEOUT=5s

MAX_BODY_BYTES=1048576

MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_HEALTH_LIVENESSSTATE_ENABLED=true
MANAGEMENT_HEALTH_READINESSSTATE_ENABLED=true

OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Optional: only if running behind proxies you trust
# TOMCAT_INTERNAL_PROXIES=127\\.0\\.0\\.1|::1|10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(1[6-9]|2\\d|3[0-1])\\.\\d{1,3}\\.\\d{1,3}
