#################################
# OS / editor junk
#################################
.DS_Store
Thumbs.db

#################################
# IDEs / Editors
#################################
.vscode/

.idea/
*.iws
*.iml
*.ipr

# Eclipse / STS / Spring tooling
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

#################################
# Env / secrets (repo-wide)
#################################
# Never commit real secrets
.env
.env.*

# Allowlist example envs (safe templates)
!.ci-tool-versions.sh
!.env.development
!.env.integration
!.env.staging

# Common local-only variants
*.env.local
*.env.*.local

#################################
# Docker / Compose
#################################
docker-compose.override.yaml
compose.override.yaml

# Docker secrets
docker/secrets/

# Local bind-mount data (keep runtime data out of git)
docker/**/data/

#################################
# Go (golang-gin/)
#################################
golang-gin/server
golang-gin/*.test
golang-gin/bin/
golang-gin/dist/
golang-gin/coverage.out
golang-gin/govulncheck.txt

#################################
# Java / Maven / Gradle
#################################
**/target/
.gradle/
**/build/
**/.cache/

#################################
# Python (python-django/)
#################################
# Bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Virtualenvs
.venv/
venv/
env/
env*/
.venv*/

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
*.whl
pip-wheel-metadata/

# Test / coverage / tooling caches
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/
.pyright/

# Local DBs (SQLite, etc.)
*.sqlite3

# CI outputs / reports
python-django/coverage.xml
python-django/coverage.json
python-django/pip-audit.json

#################################
# Logs
#################################
*.log
logs/
