{
  "id": null,
  "uid": "polyglot-http",
  "title": "Polyglot Lab - HTTP Metrics",
  "tags": ["polyglot", "http"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Env",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up, env)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "job",
        "label": "Service (job)",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up{kind=\"app\",env=~\"$env\"}, job)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "infra",
        "label": "Infra endpoints",
        "type": "custom",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "Exclude : path!~\"^/(health|ready|metrics)$\", Include : path=~\".*\"",
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "Exclude",
          "value": "path!~\"^/(health|ready|metrics)$\""
        }
      },
      {
        "name": "path",
        "label": "Path",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total{job=~\"$job\",env=~\"$env\",${infra}}, path)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Service Snapshot (current req/s, 5xx%, p95)",
      "id": 8,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by(job) (rate(http_requests_total{job=~\"$job\",env=~\"$env\",${infra}}[$__rate_interval]))",
          "legendFormat": "{{job}} req/s"
        },
        {
          "expr": "100 * sum by(job) (rate(http_requests_total{job=~\"$job\",env=~\"$env\",${infra},status=~\"5..\"}[$__rate_interval])) / clamp_min(sum by(job) (rate(http_requests_total{job=~\"$job\",env=~\"$env\",${infra}}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{job}} 5xx%"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket{job=~\"$job\",env=~\"$env\",${infra}}[$__rate_interval])))",
          "legendFormat": "{{job}} p95"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "decimals": 3 },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".* req/s$" },
            "properties": [
              { "id": "unit", "value": "reqps" },
              { "id": "min", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".* 5xx%$" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".* p95$" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "min", "value": 0 }
            ]
          }
        ]
      }
    },

    {
      "type": "timeseries",
      "title": "HTTP Request Rate by Service (req/s)",
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by(job) (rate(http_requests_total{job=~\"$job\",env=~\"$env\",${infra}}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },

    {
      "type": "timeseries",
      "title": "HTTP Errors (%)",
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "100 * sum by(job) (rate(http_requests_total{job=~\"$job\",env=~\"$env\",${infra},status=~\"5..\"}[$__rate_interval])) / clamp_min(sum by(job) (rate(http_requests_total{job=~\"$job\",env=~\"$env\",${infra}}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{job}} 5xx %"
        },
        {
          "expr": "100 * sum by(job) (rate(http_requests_total{job=~\"$job\",env=~\"$env\",${infra},status=~\"4..\"}[$__rate_interval])) / clamp_min(sum by(job) (rate(http_requests_total{job=~\"$job\",env=~\"$env\",${infra}}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{job}} 4xx %"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },

    {
      "type": "timeseries",
      "title": "HTTP Request Rate (per job/method/status)",
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum by(job, method, status) (rate(http_requests_total{job=~\"$job\",env=~\"$env\",${infra}}[$__rate_interval]))",
          "legendFormat": "{{job}} {{method}} {{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },

    {
      "type": "timeseries",
      "title": "Build Info (one per service)",
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "max by (job, version, build_time) (build_info{job=~\"$job\",env=~\"$env\"})",
          "legendFormat": "{{job}} {{version}} ({{build_time}})"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },

    {
      "type": "timeseries",
      "title": "HTTP Duration p95 (per job)",
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket{job=~\"$job\",env=~\"$env\",${infra}}[$__rate_interval])))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },

    {
      "type": "timeseries",
      "title": "HTTP Duration p95 (per path)",
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, job, path) (rate(http_request_duration_seconds_bucket{job=~\"$job\",env=~\"$env\",${infra},path=~\"$path\"}[$__rate_interval])))",
          "legendFormat": "{{job}} {{path}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },

    {
      "type": "timeseries",
      "title": "Top 5 Slowest Paths (p95)",
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "topk(5, histogram_quantile(0.95, sum by (le, job, path) (rate(http_request_duration_seconds_bucket{job=~\"$job\",env=~\"$env\",${infra},path=~\"$path\"}[$__rate_interval]))))",
          "legendFormat": "{{job}} {{path}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    }
  ]
}
